# iOS device builds — your 10-character Apple Team ID (Xcode → Settings → Accounts → team → Membership details).
# EXPO_APPLE_TEAM_ID=F4PM8R9FLU

# Clerk, API (see README)
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
#
# Simulator: http://localhost:3005/api is fine.
# Physical iPhone/Android on Wi‑Fi: use your Mac’s LAN IP (Terminal: ipconfig getifaddr en0)
# and match backend PORT, e.g. EXPO_PUBLIC_API_URL=http://192.168.0.99:3005/api
# Staging: set in EAS Secrets for the staging profile, e.g.
# EXPO_PUBLIC_API_URL=https://api.cafe-social.com/api
# After changing this: restart Metro (`npx expo start --clear`) or rebuild if JS is embedded from Xcode.
# EXPO_PUBLIC_API_URL=http://localhost:3005/api

# Guest receipt photo → staff review (off by default). Requires RECEIPT_SUBMISSIONS_ENABLED on API.
# EXPO_PUBLIC_RECEIPT_SUBMISSIONS_ENABLED=true

# Store listings & in-app Settings → Legal (public admin portal pages, no auth)
# Simulator:
# EXPO_PUBLIC_PRIVACY_POLICY_URL=http://localhost:3000/privacy
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=http://localhost:3000/terms
# Physical device (same LAN IP as EXPO_PUBLIC_API_URL, admin port 3000):
# EXPO_PUBLIC_PRIVACY_POLICY_URL=http://192.168.0.99:3000/privacy
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=http://192.168.0.99:3000/terms
# Production:
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://admin.yourdomain.com/privacy
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://admin.yourdomain.com/terms
#
# Account deletion is in-app (Settings → Delete my account); no extra env.
# Background geofence uses a long-lived API token issued at sign-in (Always location).

# RevenueCat — Test Store key works in Expo Go + sandbox. Use appl_/goog_ keys for store builds.
# EXPO_PUBLIC_REVENUECAT_API_KEY=test_...
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...
# EXPO_PUBLIC_REVENUECAT_TEST_IOS_API_KEY=test_...
# EXPO_PUBLIC_REVENUECAT_TEST_ANDROID_API_KEY=test_...
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Cafe Social Pro
# EXPO_PUBLIC_REVENUECAT_PREFERRED_PACKAGE=monthly

# Optional web manage/checkout link (Settings). Native uses RevenueCat.
# EXPO_PUBLIC_SUBSCRIPTION_URL=https://…

# Café play-time consumables (same productId:seconds as backend VENUE_PLAY_BUDGET_IAP_PRODUCTS)
# EXPO_PUBLIC_VENUE_PLAY_BUDGET_IAP_PRODUCTS=cafe_venue_play_30m:1800,cafe_venue_play_60m:3600

