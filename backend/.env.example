# --- Database ---
# Local dev (direct + runtime are the same):
DATABASE_URL=postgres://postgres:password@localhost:5432/cafe-social

# Hosted Supabase (Postgres only — keep Nest/Clerk/Socket.IO):
# Runtime (pooler, transaction mode, port 6543):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations / seed / prisma studio (direct session mode, port 5432):
# DIRECT_DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# HTTP server (default binds 0.0.0.0 so phones on Wi‑Fi can hit your Mac during dev)
# PORT=3005
# HOST=0.0.0.0

# Clerk — same application as Expo + Next admin (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
#
# JWT verification uses @clerk/backend verifyToken (not raw JWKS on the Frontend API URL).
# The public https://*.clerk.accounts.dev/.well-known/jwks.json often does NOT contain the
# session signing key → jose error "no applicable key found in the JSON Web Key Set".
#
# Required for API auth, partner invites, and guest account deletion (Clerk user purge):
# CLERK_SECRET_KEY=sk_test_...
#
# Optional: networkless verify — PEM from Dashboard → API keys → "Show JWT public key"
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
#
# Optional: if verifyToken fails with authorized parties / azp, list every origin that issues
# session JWTs (admin Next.js URL — must match the port in your browser, e.g. 3000 or 3001):
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
#
# Clerk Backend API — partner staff invite emails (optional; falls back to manual link).
# Also add ADMIN_PORTAL_ORIGIN to the Clerk Dashboard → Redirect URLs allowlist.
# ADMIN_PORTAL_ORIGIN=http://localhost:3000
# Partner/staff email deep links (set to your Vercel admin URL in staging/prod):
# PARTNER_PORTAL_BASE_URL=http://localhost:3000

# --- Player subscriptions (mobile) — RevenueCat → webhook updates `Subscription` / see RevenueCatModule ---
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace-me
REVENUECAT_SECRET_API_KEY=sk_replace_me
REVENUECAT_ENTITLEMENT_ID=Cafe Social Pro

# Café play-time IAP catalog (storeProductId:grantSeconds). Must match app EXPO_PUBLIC_VENUE_PLAY_BUDGET_IAP_PRODUCTS.
VENUE_PLAY_BUDGET_IAP_PRODUCTS=cafe_venue_play_30m:1800,cafe_venue_play_60m:3600
# VENUE_FREE_ACTIVE_PLAY_SECONDS=1800

# --- Partner / franchise SaaS (Next admin + Stripe) — updates `VenueOrganization` billing fields ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...  # for partner in-app subscription (Stripe.js Payment Element)
# STRIPE_PARTNER_PRICE_ID=price_...   # default price for admin “Checkout” button
# STRIPE_PPV_METERED_PRICE_ID=price_...  # metered pay-per-visit price ($0 base + usage)
# STRIPE_PPV_USAGE_REPORTING_ENABLED=true  # set to 0 to log billable visits without Stripe usage records
# ADMIN_PORTAL_ORIGIN must match return URLs (same as Clerk block above).

# Optional: Mapbox Geocoding — partner portal address search (forward geocode proxy).
# Free tier: 100k geocoding requests/month. Create token at mapbox.com with Geocoding scope.
# MAPBOX_ACCESS_TOKEN=pk.eyJ...

# Optional: POST JSON metrics (trial auto-lock, onboarding throttle) for ops / Zapier / Slack
# PARTNER_OPS_WEBHOOK_URL=

# Admin CMS / scripts — send as X-Admin-Key or Authorization: Bearer <key>
# ADMIN_API_KEY=

REDIS_URL=redis://127.0.0.1:6379
GAME_RUNTIME_REQUIRE_REDIS=0
GAME_RUNTIME_ALLOW_MEMORY=1

# Optional: Expo push API (higher limits / project-scoped sending)
# EXPO_ACCESS_TOKEN=

# Optional: Resend — transactional email (friend requests, party invites, staff alerts).
# Omit to skip sending. Synthetic Player emails (`*@clerk.local`) are never mailed.
# https://resend.com — verify a domain or use onboarding@resend.dev for tests.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="Cafe Social <hello@yourdomain.com>"

# Venue “order a drink” nudge — starts on OS ring enter (app killed) or foreground presence.
# A 5-minute scheduler sends due nudges without the app open. Set ENABLED=false to disable.
# VENUE_ORDER_NUDGE_ENABLED=true
# VENUE_ORDER_NUDGE_AFTER_MINUTES=30
# VENUE_ORDER_NUDGE_TITLE=Still here?
# VENUE_ORDER_NUDGE_BODY=Thirsty? Treat yourself to something from the menu at {{venueName}}.

# Nearby arrival push when a player enters a venue's marketing ring (OS geofence enter).
# Requires Always location + long-lived background token (issued by POST /players/me/background-token).
# PROXIMITY_ARRIVAL_PUSH_ENABLED=true
# PROXIMITY_NUDGE_VENUE_COOLDOWN_MINUTES=240
# PROXIMITY_NUDGE_VENUE_DAILY_MAX=3

# Guest receipt photo → staff review (optional perk lock). Off by default; set true to enable API + partner receipts UI.
# RECEIPT_SUBMISSIONS_ENABLED=true
# PROXIMITY_NUDGE_GLOBAL_DAILY_MAX=5

# Guest daily game cap per venue (UTC day); venue/org CMS overrides take precedence when set.
# VENUE_GUEST_PLAY_DAILY_GAMES=50

# Pay-per-visit attribution ledger (polygon enter after nudge + min dwell; billing not wired yet)
# ATTRIBUTION_ENTER_WINDOW_MINUTES=15
# ATTRIBUTION_MIN_DWELL_MINUTES=15
# STRIPE_PPV_USAGE_REPORTING_ENABLED=true

