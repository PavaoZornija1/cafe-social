# Claude Code local settings (personal permission grants)
.claude/settings.local.json

# Native projects are generated by prebuild (CNG) — app.config.js is the source
# of truth. Committing ios/ made it drift and silently drop camera, photo-library,
# push and Apple-signin entries from Info.plist.
app/ios/
app/android/

# --- store submission credentials (never commit) ---
app/credentials/
*.p8
google-service-account*.json
play-service-account*.json
