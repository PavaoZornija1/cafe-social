# Copy to .env on the Oracle VM (deploy/oracle/.env) — never commit real values.

# --- Supabase (same as backend/.env on your Mac) ---
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# --- Clerk ---
CLERK_SECRET_KEY=sk_test_...
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://YOUR-ADMIN.vercel.app,https://YOUR-API-DOMAIN

# --- Admin portal (Vercel) ---
ADMIN_PORTAL_ORIGIN=https://YOUR-ADMIN.vercel.app
PARTNER_PORTAL_BASE_URL=https://YOUR-ADMIN.vercel.app

# --- Caddy (docker compose passes this into Caddyfile) ---
API_DOMAIN=api.yourdomain.com

# On-box Redis from docker-compose (overrides Upstash). Compose also sets REDIS_URL.
REDIS_URL=redis://redis:6379
GAME_RUNTIME_REQUIRE_REDIS=1
# Leave unset / 0 in production (memory fallback is for local debug only)
GAME_RUNTIME_ALLOW_MEMORY=0

# Optional
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="Cafe Social <onboarding@resend.dev>"
# EXPO_ACCESS_TOKEN=
# ADMIN_API_KEY=

# --- Stripe (partner SaaS + PPV; test mode for pilot) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PARTNER_PRICE_ID=price_...          # €49/mo licensed
# STRIPE_PPV_METERED_PRICE_ID=price_...      # €0.50/visit metered
# STRIPE_PPV_USAGE_REPORTING_ENABLED=true

